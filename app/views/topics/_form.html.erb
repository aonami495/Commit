<%= form_with(model: topic) do |form| %>
<% if topic.errors.any? %>
<div style="color: red">
    <h2><%= pluralize(topic.errors.count, "件") %> のエラーがあります</h2>

    <ul>
        <% topic.errors.each do |error| %>
        <li><%= error.full_message %></li>
        <% end %>
    </ul>
</div>
<% end %>

<div class="p-4 grid gap-4">
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, class:"form-input"%>
</div>

<div class="p-4 grid gap-4">
    <%= form.label :description, style: "display: block" %>
    <%= form.text_area :description, class:"form-input" %>
</div>

<div class="p-4 grid gap-2">
    <%= form.label :emoji, style: "display: block" %>
    <%= form.text_field :emoji, class:"form-input"%>
</div>

<div>
    <%= form.submit "保存する", class:"btn-primary" %>
</div>
<% end %>