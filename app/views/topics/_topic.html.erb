<div id="<%= dom_id topic %>" class="space-y-3">
    <div class="flex item-center gap-2">
        <span class="text-3xl mt-3">
            <%= topic.emoji %>
        </span>

        <h1 class="font-bold text-2xl py-4">
            <%= topic.name %>
        </h1>

    </div>

    <p class="text-taupe-700 whitespace-pre-line">
        <%= topic.description %>
    </p>

</div>