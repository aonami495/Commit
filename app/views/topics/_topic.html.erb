<div id="<%= dom_id topic %>">
  <p>
    <strong>Name:</strong>
    <%= topic.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= topic.description %>
  </p>

  <p>
    <strong>Emoji:</strong>
    <%= topic.emoji %>
  </p>

  <p>
    <strong>Archived:</strong>
    <%= topic.archived %>
  </p>

  <p>
    <strong>User:</strong>
    <%= topic.user_id %>
  </p>

</div>
