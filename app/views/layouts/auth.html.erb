<!DOCTYPE html>
<html>

<head>
    <title><%= content_for(:title) || "Commit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
</head>

<body class="bg-taupe-50">
    <div class="min-h-screen flex items-center justify-center">
        <div class="w-full max-w-md p-8 bg-white rounded-lg shadow-md">
            <h1 class="text-2xl font-bold mb-6 text-center">Commit</h1>

            <% if notice %><p class="text-green-700 mb-4"><%= notice %></p><% end %>
            <% if alert %><p class="text-red-700 mb-4"><%= alert %></p><% end %>

            <%= yield %>
        </div>
    </div>
</body>

</html>