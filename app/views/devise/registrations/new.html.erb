<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
<%= render "devise/shared/error_messages", resource: resource %>

<div class="field mb-4">
    <p><%= f.label :email %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email",class:"form-input" %></p>
</div>

<div class="field mb-4">
    <p><%= f.label :name %></p>
    <p><%= f.text_field :name, autocomplete: "name",class:"form-input" %></p>
</div>

<div class="field mb-4">
    <p><%= f.label :password %></p>
    <% if @minimum_password_length %>
    <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password",class:"form-input" %></p>
</div>

<div class="field mb-8">
    <p><%= f.label :password_confirmation %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password",class:"form-input" %></p>
</div>

<div class="actions mb-4">
    <%= f.submit t(".sign_up"),class:"btn-primary" %>
</div>
<% end %>

<div class="shard-link ">
    <%= render "devise/shared/links" %>
</div>
</div>