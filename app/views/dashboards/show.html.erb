<div class="flex">
    <h1 class="text-4xl mt-4  ">Dashboards</h1>
</div>

<% if !@topics.empty? %>
<% @topics.each do |topic|%>
<%= link_to topic, class: "block" do %>
<div>
    <%= topic.emoji %>
    <%= topic.name %>
    <%= topic.description %>
</div>
<% end %>
<% end %>

<% else %>

<%= link_to "新しく作成する", new_topic_path %>

<% end %>

